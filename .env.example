# Copy to .env, fill in, and keep it private: chmod 600 .env
# A blank value means "use the default". docs/operations.md explains every setting.

# ---- Reaching Jev ----------------------------------------------------------------------
# typesafe (the default: straight to TypeSafe, about half the delay) | gateway | mock (free, random answers)
JEV_PROVIDER=typesafe
# TypeSafe key. Required for JEV_PROVIDER=typesafe.
TYPESAFE_AI_API_KEY=
# Vercel AI Gateway key. Required for JEV_PROVIDER=gateway.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=typesafe-ai/jev
# List price per million input tokens, used to work out what a call cost when the route does not
# say. The gateway reports its own figure and ignores this; TypeSafe's API reports none.
JEV_USD_PER_MTOK=0.042

# ---- Live dashboard (npm run dashboard, then http://localhost:4000) ----------------------
# Where the pipelines send their one-way status messages: 1 = this machine, 0 = nowhere,
# or the address of the machine running the dashboard (e.g. a Pi reporting to your laptop)
TELEMETRY=1
# 0.0.0.0 makes the page reachable from other machines on your network. It has no password.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4000

# ---- Reports ---------------------------------------------------------------------------
# The exchange's fee on each fill, in basis points, as its fee schedule quotes it (0.60% = 60).
# A round trip pays it twice, and the spread is charged on top. Blank means 5, Coinbase's lowest
# published taker fee; 0 shows what the moves alone were worth.
FEE_BPS_PER_SIDE=
PNL_NOTIONAL_USD=10000
# A stock quote wider than this (basis points) is not a usable price
MAX_SPREAD_BPS=50

# ---- News path -------------------------------------------------------------------------
# Which sources to run: rss, alpaca, edgar, x (or "none", e.g. with NEWS_MANUAL=1)
NEWS_SOURCES=rss,alpaca,edgar,x
# Feeds as name=url pairs (defaults: Fed, CFTC, Coinbase status, CoinDesk, Cointelegraph)
NEWS_FEEDS=
# Seconds between checks: feeds that resend everything each time / feeds that can answer "nothing changed"
NEWS_POLL_S=30
NEWS_FAST_POLL_S=10
# Required for the SEC's feeds and company list (SEC fair access policy): "Your Name your-email@example.com"
NEWS_USER_AGENT=
# 1 = ask only about instruments whose outcome can be measured (market open, usable quote). 0 = ask about everything.
NEWS_ONLY_TRADABLE=1
# News items judged at the same time
NEWS_MAX_INFLIGHT=4

# Alpaca (US stock quotes and the Benzinga news stream). Free plan: IEX quotes, 30 live symbols.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex (free) or sip (paid, all US exchanges)
ALPACA_FEED=iex

# X API (read-only use needs only the bearer token). Billed per post read, not per search.
X_BEARER_TOKEN=
# Accounts to follow (default: federalreserve SECGov CFTC USTreasury BLS_gov coinbase)
X_ACCOUNTS=
X_POLL_S=10
X_MAX_POSTS_PER_DAY=500

# ---- Market-data path ------------------------------------------------------------------
# Milliseconds between questions to Jev (0 = back to back, about three times the cost)
JEV_MIN_INTERVAL_MS=1000
# 1 = "npm run live" also saves the market data it sees, so that run can be replayed later
RECORD=0
# "Flat" = a move smaller than this many typical moves for the horizon (default 2; 0 = fixed thresholds)
JEV_FLAT_SIGMAS=
